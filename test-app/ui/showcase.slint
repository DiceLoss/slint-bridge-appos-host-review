import { Palette, Label, Caption, Heading, Card, Action, NavItem } from "showcase/widgets.slint";
import { Overview } from "showcase/overview.slint";
import { Controls } from "showcase/controls.slint";
import { Devices } from "showcase/devices.slint";
import { Motion } from "showcase/motion.slint";
import { Media } from "showcase/media.slint";
import { Lab } from "showcase/lab.slint";
import { DeviceRow, EventRow } from "showcase/models.slint";
export { DeviceRow, EventRow }

export component Showcase inherits Window {
    title: "Slint Bridge • Studio";
    preferred-width: 1024px; preferred-height: 600px;
    min-width: 960px; min-height: 600px;
    default-font-family: "DejaVu Sans";
    default-font-size: 15px;
    background: transparent;
    in-out property <int> page;
    in property <int> ticks;
    in property <float> phase;
    in property <int> event-count;
    in property <[float]> samples;
    in-out property <string> station-name: "NX5 Studio";
    in-out property <float> level: 68;
    in-out property <bool> power: true;
    in-out property <bool> notifications: true;
    in-out property <int> mode;
    in property <string> saved-summary: "No profile applied yet.";
    in property <[DeviceRow]> devices;
    in-out property <string> query;
    in-out property <bool> online-only;
    in property <string> selected-name: "None";
    in property <string> device-details;
    in-out property <bool> running: true;
    in-out property <float> speed: 1;
    in property <bool> expanded;
    in property <image> wallpaper: @image-url("assets/coastal-background.png");
    in property <image> overlay;
    in-out property <float> alpha: 75;
    in property <bool> cutout;
    in property <[EventRow]> events;
    in property <[bool]> exercised;
    in property <int> completed;
    in property <int> taps;
    in property <int> drag-count;
    in-out property <float> drag-x: 0.5;
    in-out property <float> drag-y: 0.5;
    in property <int> dialog;
    in property <string> keyboard-draft;
    in property <string> toast;
    callback navigate(int);
    callback apply-profile();
    callback open-dialog(int);
    callback confirm-reset();
    callback key(string);
    callback filter();
    callback select-device(int);
    callback toggle-motion();
    callback replay();
    callback toggle-cutout();
    callback blend-changed();
    callback tap(int);
    callback dragged();
    callback clear-journal();

    if !(root.page == 4 && root.cutout): wallpaper-image := Image {
        source: root.wallpaper; width: 100%; height: 100%; image-fit: cover;
    }
    sidebar := Rectangle {
        x: 0; y: 0; width: 174px; height: 100%; background: #112a3b;
        VerticalLayout {
            padding: 12px; spacing: 7px;
            Rectangle {
                height: 83px;
                Rectangle { x: 8px; y: 14px; width: 30px; height: 30px; border-radius: 8px; background: #51dec0; Text { text: "S"; font-size: 21px; font-weight: 800; color: #112a3b; horizontal-alignment: center; vertical-alignment: center; } }
                Text { x: 47px; y: 14px; text: "SLINT"; font-size: 21px; font-weight: 700; color: white; }
                Text { x: 8px; y: 57px; text: "B R I D G E  /  S T U D I O"; font-size: 9px; color: #90aaba; }
            }
            nav-overview := NavItem { text: "Overview"; number: "01"; selected: root.page == 0; clicked => { root.navigate(0); } }
            nav-controls := NavItem { text: "Controls"; number: "02"; selected: root.page == 1; clicked => { root.navigate(1); } }
            nav-devices := NavItem { text: "Devices"; number: "03"; selected: root.page == 2; clicked => { root.navigate(2); } }
            nav-motion := NavItem { text: "Motion"; number: "04"; selected: root.page == 3; clicked => { root.navigate(3); } }
            nav-media := NavItem { text: "Layers"; number: "05"; selected: root.page == 4; clicked => { root.navigate(4); } }
            nav-lab := NavItem { text: "Interaction lab"; number: "06"; selected: root.page == 5; clicked => { root.navigate(5); } }
            Rectangle { vertical-stretch: 1; }
            Rectangle { height: 66px; border-radius: 8px; background: #1b3546;
                Text { x: 12px; y: 12px; text: "●  DEMO SESSION"; font-size: 11px; color: #67dfc5; }
                Text { x: 12px; y: 36px; text: "Touch. Explore. Verify."; font-size: 10px; color: #a5bbc8; }
            }
        }
    }
    Rectangle {
        x: 174px; y: 0; width: parent.width - 174px; height: 82px; background: white;
        Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Palette.line; }
        VerticalLayout {
            padding-left: 24px; padding-top: 15px; padding-bottom: 15px;
            Caption { text: "SLINT SHOWCASE   /   " + (root.page + 1) + " OF 6"; font-size: 10px; }
            Heading { text: ["The interface, in motion", "Controls & forms", "A connected workspace", "Animation studio", "Images & transparency", "Interaction lab"][root.page]; font-size: 25px; }
        }
        if root.width >= 950px: Rectangle { x: parent.width - 163px; y: 25px; width: 140px; height: 30px; border-radius: 15px; background: #e9f4f0;
            Label { text: "●  Interactive demo"; font-size: 11px; color: Palette.teal; horizontal-alignment: center; }
        }
    }
    content := Rectangle {
        x: 198px; y: 102px; width: parent.width - 222px; height: parent.height - 140px;
        if root.page == 0: Overview { event-count: root.event-count; ticks: root.ticks; samples: root.samples; navigate(p) => { root.navigate(p); } }
        if root.page == 1: Controls { station-name <=> root.station-name; level <=> root.level; power <=> root.power; notifications <=> root.notifications; mode <=> root.mode; saved-summary: root.saved-summary; apply => { root.apply-profile(); } keyboard => { root.open-dialog(3); } reset => { root.open-dialog(1); } }
        if root.page == 2: Devices { rows: root.devices; query <=> root.query; online-only <=> root.online-only; selected-name: root.selected-name; filter => { root.filter(); } keyboard => { root.open-dialog(4); } select(id) => { root.select-device(id); } }
        if root.page == 3: Motion { wallpaper: root.wallpaper; phase: root.phase; ticks: root.ticks; running <=> root.running; speed <=> root.speed; expanded: root.expanded; toggle => { root.toggle-motion(); } replay => { root.replay(); } }
        if root.page == 4: Media { overlay: root.overlay; alpha <=> root.alpha; cutout: root.cutout; toggle-cutout => { root.toggle-cutout(); } blend-changed => { root.blend-changed(); } }
        if root.page == 5: Lab { events: root.events; exercised: root.exercised; completed: root.completed; taps: root.taps; drag-count: root.drag-count; drag-x <=> root.drag-x; drag-y <=> root.drag-y; tap(i) => { root.tap(i); } dragged => { root.dragged(); } clear => { root.clear-journal(); } }
    }
    footer := Rectangle {
        x: 198px; y: parent.height - 29px; width: parent.width - 222px; height: 22px;
        background: #102a3bb3; border-radius: 4px;
        Caption { x: 8px; width: parent.width - 16px; height: 100%; text: round(root.width / 1px) + " × " + round(root.height / 1px) + "   /   Slint software renderer                                            Demo data · Session state"; font-size: 10px; color: #eaf7ff; }
    }
    if root.toast != "": Rectangle {
        x: parent.width - 425px; y: parent.height - 68px; width: 400px; height: 43px; background: #153f4b; border-radius: 8px;
        Text { text: root.toast; color: white; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
    }
    if root.dialog != 0: Rectangle {
        background: #071b2b99;
        TouchArea { }
        FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape { root.open-dialog(0); }
            return accept;
        }
        dialog-card := Card {
            background: white;
            width: root.dialog >= 3 ? 620px : 440px;
            height: root.dialog >= 3 ? 410px : 250px;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            VerticalLayout {
                padding: 24px; spacing: 14px;
                Heading { text: root.dialog == 1 ? "Reset this profile?" : root.dialog == 2 ? root.selected-name : root.dialog == 3 ? "Station keyboard" : "Search keyboard"; }
                if root.dialog < 3: Label { text: root.dialog == 1 ? "Restore the demo defaults. Your interaction journal will be kept." : root.device-details; wrap: word-wrap; vertical-stretch: 1; }
                if root.dialog >= 3: Rectangle { height: 40px; background: #edf4f5; border-radius: 6px; Label { x: 12px; width: parent.width - 24px; text: root.keyboard-draft + "│"; } }
                if root.dialog >= 3: VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout { spacing: 4px; for k in ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]: Action { text: k; min-width: 30px; clicked => { root.key(k); } } }
                    HorizontalLayout { spacing: 4px; for k in ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"]: Action { text: k; min-width: 30px; clicked => { root.key(k); } } }
                    HorizontalLayout { spacing: 4px; for k in ["A", "S", "D", "F", "G", "H", "J", "K", "L"]: Action { text: k; min-width: 30px; clicked => { root.key(k); } } }
                    HorizontalLayout { spacing: 4px; for k in ["Z", "X", "C", "V", "B", "N", "M", "-"]: Action { text: k; min-width: 30px; clicked => { root.key(k); } } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    if root.dialog >= 3: Action { text: "Space"; clicked => { root.key(" "); } }
                    if root.dialog >= 3: Action { text: "⌫"; clicked => { root.key("backspace"); } }
                    dialog-cancel := Action { text: root.dialog == 2 ? "Close" : "Cancel"; clicked => { root.open-dialog(0); } }
                    if root.dialog != 2: dialog-confirm := Action { text: root.dialog == 1 ? "Reset profile" : "Done"; primary: true; clicked => { if root.dialog == 1 { root.confirm-reset(); } else { root.key("done"); } } }
                }
            }
        }
        }
    }
}
