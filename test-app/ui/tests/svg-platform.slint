export component SvgPlatformTest inherits Window {
    out property <image> embedded-image: @image-url("../assets/scaling-reference.svg");
    in property <image> picture;
    in property <float> zoom: 1;
    in property <bool> visible-image: true;
    background: #183448;
    Rectangle {
        x: 13.25px; y: 11.5px;
        width: parent.width - 25px; height: parent.height - 23px;
        clip: true;
        Image {
            source: root.picture; visible: root.visible-image;
            x: -7.5px; y: 4.25px;
            width: 128px * root.zoom; height: 80px * root.zoom;
            opacity: 0.65; image-fit: fill;
        }
        Image {
            source: root.embedded-image;
            x: parent.width - 43px; y: parent.height - 31px;
            width: 48px; height: 30px;
        }
    }
}
