import { Slider, Switch } from "std-widgets.slint";
import { Label, Caption, Heading, Card, Action, Palette } from "widgets.slint";

export component Media inherits VerticalLayout {
    in property <image> overlay;
    in-out property <float> alpha;
    in property <bool> cutout;
    callback toggle-cutout();
    callback blend-changed();
    spacing: 14px;
    Card {
        height: 91px;
        HorizontalLayout {
            padding: 16px; spacing: 14px;
            VerticalLayout { Heading { text: "Layers & light"; } Caption { text: "Photo background • scaled image • translucent overlay"; } }
            cutout-button := Action { text: root.cutout ? "Show image background" : "Open transparent area"; width: 208px; clicked => { root.toggle-cutout(); } }
        }
    }
    // This area and the root window have no opaque background in cutout mode.
    Rectangle {
        min-height: 150px;
        if !root.cutout: Rectangle { x: 20px; y: 20px; width: 214px; height: 53px; background: #102a3bc9; border-radius: 8px; Text { text: "IMAGE BACKGROUND\nCoastal landscape"; color: white; font-size: 14px; x: 12px; width: parent.width - 24px; height: 100%; vertical-alignment: center; } }
        Image { source: root.overlay; x: parent.width * 0.5; y: 12px; width: min(190px, parent.height - 24px); height: self.width; opacity: root.alpha / 100; }
        Rectangle { x: 16px; y: parent.height - 48px; width: parent.width - 32px; height: 34px; background: #102a3bd9; border-radius: 6px; Text { text: root.cutout ? "TRANSPARENT WINDOW  /  no video source connected" : "Opaque backdrop + per-pixel alpha texture + adjustable opacity"; color: white; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; } }
    }
    Card {
        height: 116px;
        VerticalLayout {
            padding: 16px; spacing: 8px;
            HorizontalLayout { spacing: 12px;
                Label { text: "Overlay opacity"; width: 130px; }
                alpha-slider := Slider { minimum: 0; maximum: 100; step: 1; value <=> root.alpha; changed => { root.blend-changed(); } height: 44px; }
                Label { text: round(root.alpha) + "%"; width: 50px; }
            }
            HorizontalLayout {
                spacing: 6px;
                for a in [0, 25, 50, 75, 100]: Rectangle {
                    background: #e7edf1; height: 25px;
                    Rectangle { width: 50%; height: 100%; background: #b8c8d2; }
                    Rectangle { background: #008b83; opacity: a / 100; }
                    Text { text: a + "%"; color: a > 50 ? white : #16394b; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }
}
