import { LineEdit, Switch } from "std-widgets.slint";
import { DeviceRow } from "models.slint";
import { Label, Caption, Heading, Card, Action, Meter, Palette } from "widgets.slint";

export component Devices inherits VerticalLayout {
    in property <[DeviceRow]> rows;
    in-out property <string> query;
    in-out property <bool> online-only;
    in property <string> selected-name;
    private property <bool> horizontal: false;
    callback filter();
    callback keyboard();
    callback select(int);
    spacing: 12px;
    HorizontalLayout {
        spacing: 12px;
        search-input := LineEdit { text <=> root.query; placeholder-text: "Search demo devices or rooms"; height: 44px; edited => { root.filter(); } }
        search-keyboard := Action { text: "Keyboard"; width: 104px; clicked => { root.keyboard(); } }
        online-filter := Switch { text: "Online only"; checked <=> root.online-only; toggled => { root.filter(); } }
        clear-filter := Action { text: "Clear"; width: 90px; clicked => { root.query = ""; root.online-only = false; root.filter(); } }
    }
    Card {
        VerticalLayout {
            padding: 16px; spacing: 8px;
            HorizontalLayout {
                spacing: 12px;
                Heading { text: "Demo device directory"; }
                Caption { text: root.rows.length + " results"; horizontal-alignment: right; }
                orientation-toggle := Action { text: root.horizontal ? "Vertical list" : "Horizontal cards"; clicked => { root.horizontal = !root.horizontal; } }
            }
            Caption { text: root.horizontal ? "Swipe left and right to discover all devices. Touch a card for details." : "Touch a row for details. Drag the list to discover all devices."; }
            if !root.horizontal: device-list := Flickable {
                mouse-drag-pan-enabled: true;
                content-width: self.width;
                VerticalLayout {
                    spacing: 6px;
                    for device in root.rows: row := Rectangle {
                        height: 66px; border-radius: 8px; background: touch.pressed ? #ccece7e6 : #f2f6f8aa;
                        accessible-role: button; accessible-label: device.name;
                        accessible-action-default => { root.select(device.id); }
                        HorizontalLayout {
                            padding: 12px; spacing: 12px;
                            Rectangle { width: 38px; border-radius: 8px; background: device.online ? #d7eee8 : #e2e8ed; Label { text: "" + device.id; horizontal-alignment: center; color: Palette.teal; } }
                            VerticalLayout { Label { text: device.name; font-weight: 600; } Caption { text: device.location; } }
                            Label { width: 80px; text: device.online ? "Online" : "Offline"; color: device.online ? Palette.teal : Palette.muted; }
                            Label { width: 70px; text: device.level + "%"; horizontal-alignment: right; }
                            Label { width: 20px; text: "›"; horizontal-alignment: right; }
                        }
                        touch := TouchArea { clicked => { root.select(device.id); } }
                    }
                    if root.rows.length == 0: Label { height: 110px; text: "No matching devices. Clear the filters to start again."; horizontal-alignment: center; }
                }
            }
            if root.horizontal: horizontal-list := Flickable {
                mouse-drag-pan-enabled: true;
                content-height: self.height;
                content-width: max(self.width, root.rows.length * 244px - 12px);
                for device[index] in root.rows: device-card := Rectangle {
                    x: index * 244px;
                    width: 232px; height: horizontal-list.height;
                    border-radius: 8px; background: card-touch.pressed ? #ccece7e6 : #f2f6f8aa;
                    accessible-role: button; accessible-label: device.name;
                    accessible-action-default => { root.select(device.id); }
                    VerticalLayout {
                        padding: 16px; spacing: 8px;
                        HorizontalLayout {
                            Caption { text: "DEVICE " + device.id; }
                            Caption { text: device.online ? "Online" : "Offline"; horizontal-alignment: right; color: device.online ? Palette.teal : Palette.muted; }
                        }
                        Label { text: device.name; font-size: 17px; font-weight: 700; }
                        Caption { text: device.location; }
                        Heading { text: device.level + "%"; font-size: 40px; vertical-stretch: 1; }
                        Caption { text: "Output level"; }
                        Meter { value: device.level; }
                        Caption { text: "Touch for details  ›"; }
                    }
                    card-touch := TouchArea { clicked => { root.select(device.id); } }
                }
                if root.rows.length == 0: Label { width: horizontal-list.width; height: horizontal-list.height; text: "No matching devices. Clear the filters to start again."; horizontal-alignment: center; }
            }
        }
    }
    Rectangle {
        height: 24px; background: #102a3bb3; border-radius: 4px;
        Caption { x: 10px; width: parent.width - 20px; height: 100%; color: #eaf7ff; text: "Selected: " + root.selected-name + "   /   All device values are simulated."; }
    }
}
