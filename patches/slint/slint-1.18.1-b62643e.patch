+                pixel.green = div255(pixel.green as u16 * a) as u8 + color.green;
+                pixel.blue = div255(pixel.blue as u16 * a) as u8 + color.blue;
+                pixel.alpha = (pixel.alpha as u16 + color.alpha as u16
