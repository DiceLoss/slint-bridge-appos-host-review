+#[cfg(feature = "std")]
+struct RasterEntry {
+    source: vtable::VWeak<super::OpaqueImageVTable, ParsedSVG>,
+    size: Option<euclid::Size2D<u32, PhysicalPx>>,
+    buffer: SharedImageBuffer,
+    bytes: usize,
