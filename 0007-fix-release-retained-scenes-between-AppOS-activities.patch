From 201205ab184642bd91f5d81b37e93e5e15085f8b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=E5=8D=83=E5=A4=8F?= <qianxia@d-power.com.cn>
Date: Sun, 25 Oct 2026 03:09:38 +0800
Subject: [PATCH 7/8] fix: release retained scenes between AppOS activities

---
 src/runtime.rs       | 12 ++++++++++++
 src/tests/runtime.rs |  7 ++++++-
 2 files changed, 18 insertions(+), 1 deletion(-)

diff --git a/src/runtime.rs b/src/runtime.rs
index 2581487..e37ed51 100644
--- a/src/runtime.rs
+++ b/src/runtime.rs
@@ -49,6 +49,7 @@ pub(crate) fn request_full_redraw() {
 pub(crate) fn release_graphics_caches() {
     ACTIVE_WINDOW.with(|active| {
         if let Some(window) = active.borrow().upgrade() {
+            window.release_scene_cache();
             window.renderer.clear_font_caches();
             window.renderer.clear_image_caches();
             window.force_full_repaint.set(true);
@@ -135,6 +136,17 @@ impl BridgeWindow {
             size: self.size.to_logical(1.0),
         });
     }
+
+    fn release_scene_cache(&self) {
+        let configured = self.renderer.repaint_buffer_type();
+        let temporary = if configured == RepaintBufferType::NewBuffer {
+            RepaintBufferType::ReusedBuffer
+        } else {
+            RepaintBufferType::NewBuffer
+        };
+        self.renderer.set_repaint_buffer_type(temporary);
+        self.renderer.set_repaint_buffer_type(configured);
+    }
 }
 
 impl WindowAdapter for BridgeWindow {
diff --git a/src/tests/runtime.rs b/src/tests/runtime.rs
index 90664be..f5cc76d 100644
--- a/src/tests/runtime.rs
+++ b/src/tests/runtime.rs
@@ -117,6 +117,7 @@ fn appos_host_reuses_one_adapter_across_sequential_activity_roots() {
     slint::platform::set_platform(Box::new(platform)).unwrap();
 
     let outgoing = LoopScene::new().unwrap();
+    let outgoing_weak = outgoing.as_weak();
     outgoing.show().unwrap();
     outgoing.hide().unwrap();
     // Keep the outgoing component alive while constructing the incoming one;
@@ -127,8 +128,12 @@ fn appos_host_reuses_one_adapter_across_sequential_activity_roots() {
     crate::runtime::run_until_first_presented_frame().unwrap();
 
     assert!(incoming.window().is_visible());
-    incoming.hide().unwrap();
     drop(outgoing);
+    assert!(
+        outgoing_weak.upgrade().is_none(),
+        "the reused adapter retained the hidden outgoing Activity root"
+    );
+    incoming.hide().unwrap();
 }
 
 fn send_input(writer: &mut File, events: &[(u16, u16, i32)]) {
